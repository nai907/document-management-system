# Copy this file to .env and fill in real values to switch the app over to
# cloud database + storage. Leave a variable unset (or delete this file
# entirely) to keep using local SQLite + local disk for that piece.

# --- Database (Supabase Postgres or any standard Postgres connection string) ---
# Supabase: Project -> Settings -> Database -> Connection string (URI, "Session" mode)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- File storage (Supabase Storage / any S3-compatible provider) ---
# Supabase: Project -> Settings -> Storage -> "S3 Connection" (NOT the general
# Project API keys page - those sb_publishable_/sb_secret_ keys won't work
# here, this needs genuine S3-format access keys from the Storage settings
# specifically). Also create the bucket itself under Storage -> New bucket,
# and make sure "Public bucket" is left OFF.
AWS_STORAGE_BUCKET_NAME=documents
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_ENDPOINT_URL=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=us-east-1

# --- Django core (only matters once this is actually deployed somewhere) ---
# SECRET_KEY=generate-a-real-random-secret-key
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# --- Backups ---
# Where `manage.py run_backup` (and the automatic timer below) write archives,
# and how many to keep before pruning the oldest.
# BACKUP_DIR=backend/backups
# BACKUP_RETENTION=14
# Runs a backup automatically every N seconds for as long as `manage.py
# runserver` stays up (default 86400 = daily). Set to 0 to turn this off and
# rely on an OS-level scheduler (cron / Task Scheduler) instead - see README.
# BACKUP_INTERVAL_SECONDS=86400
# Where scheduled backups land. 'local' (default) = zips in BACKUP_DIR on
# this machine. 'bucket' = uploaded to the S3 bucket above under
# BACKUP_S3_PREFIX - use this on hosting with an ephemeral disk, where
# anything written locally is wiped on every redeploy.
# BACKUP_STORAGE=local
# BACKUP_S3_PREFIX=backups/
